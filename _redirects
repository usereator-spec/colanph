# Area amministrativa: accesso solo con ruolo Identity "admin".
/admin/*                 /admin/:splat                 200!  Role=admin
/admin/*                 /login.html                  302!

# Pagine dinamiche Works.
# Il browser mantiene l'URL /works/sezioni/... o /works/progetti/...
# mentre Netlify serve internamente work.html.
/works/sezioni/:slug     /work.html                   200!
/works/progetti/:slug    /work.html                   200!

# Compatibilità con i vecchi URL.
/work-eventi.html        /works/sezioni/eventi         301!
/work-architettura.html  /works/sezioni/architettura   301!
/work-street.html        /works/sezioni/street         301!
/work-food.html          /works/sezioni/food           301!
/work-interni.html       /works/sezioni/interni        301!
/work-attivita.html      /works/sezioni/attivita       301!